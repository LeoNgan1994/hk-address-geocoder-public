# Application — public deployment (no database required)
PORT=3000
NODE_ENV=development

# Leave empty to run without PostgreSQL (cache and DB logs disabled)
DATABASE_URL=

CACHE_ENABLED=false
CACHE_TTL_DAYS=90

LOG_TO_DB=false
LOG_TO_FILE=false
LOG_ADDRESS_MODE=truncate
LOG_ADDRESS_MAX_LENGTH=200

MAX_INPUT_LENGTH=2048
REQUEST_TIMEOUT_MS=30000

# Set to true and provide ADMIN_API_KEY to require authentication
ENABLE_API_KEY=false
ADMIN_API_KEY=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DAILY=500
RATE_LIMIT_PER_MINUTE=60

RULE_CONFIDENCE_THRESHOLD=0.65

# Lamp post — LandsD public API
LAMP_POST_ACQUISITION_ORDER=api
LAMP_POST_LANDSD_ENABLED=true
LAMP_POST_LANDSD_BASE_URL=https://mapapi.geodata.gov.hk/gs/api/v1.0.0
LAMP_POST_DB_ENABLED=false

# Government address — LandsD / map.gov.hk
GOVERNMENT_LANDSD_BASE_URL=https://www.map.gov.hk/gs/api/v1.0.0

LLM_ENABLED=false

# Demo UI branding (served via GET /demo/config.json)
DEMO_EYEBROW=Leo Ngan
DEMO_TITLE=HK Address Geocoder
DEMO_SUBTITLE=Hong Kong address and lamp post coordinate lookup demo
DEMO_CREDIT=Powered by Leo Ngan
DEMO_MASCOT_URL=
DEMO_QUERY_MODES=auto,lamp
